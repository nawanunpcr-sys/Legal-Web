# ── open-notebook configuration ────────────────────────────────
# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่าตามจริง:  cp .env.example .env

# REQUIRED — กุญแจเข้ารหัสสำหรับเก็บ API key ในฐานข้อมูล (อย่างน้อย 16 ตัวอักษร)
OPEN_NOTEBOOK_ENCRYPTION_KEY=เปลี่ยนเป็นสตริงลับยาวๆ-อย่างน้อย16ตัว

# REQUIRED (เพื่อความปลอดภัย) — รหัสผ่านที่ป้องกัน Web UI และ REST API
# ค่านี้ต้องตรงกับ secret OPEN_NOTEBOOK_PASSWORD ฝั่ง Supabase
OPEN_NOTEBOOK_PASSWORD=เปลี่ยนเป็นรหัสผ่านของคุณ

# ── LLM provider — ใส่อย่างน้อยหนึ่งเจ้าเพื่อให้สรุปเอกสารได้ ──
# (หรือจะตั้งทีหลังผ่าน UI: Settings → API Keys ก็ได้)
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GOOGLE_API_KEY=...

# ── การอ่าน PDF ภาษาไทย (ผ่านไลบรารี content-core) ──
# เอนจินอ่านเอกสาร:
#   auto    = เดาให้อัตโนมัติ (ค่าเริ่มต้น)
#   simple  = เร็ว เหมาะกับ PDF ที่เป็นข้อความจริง (ราชกิจจาฯ ส่วนใหญ่เป็นแบบนี้)
#   docling = ทำ layout + OCR เหมาะกับ PDF สแกน/เป็นรูปภาพ (ช้ากว่า)
CCORE_DOCUMENT_ENGINE=auto
# ถ้าเจอเอกสารสแกนแล้วอ่านไม่ออก ให้เปลี่ยนเป็น: CCORE_DOCUMENT_ENGINE=docling

# โมเดล LLM ที่ใช้สรุป — แนะนำตัวที่อ่านไทยเก่งและ context ยาว
# (Gemini Flash / GPT-4o-mini คุ้มค่าและรองรับไทยดี)
# CCORE_LLM_PROVIDER=gemini
# CCORE_LLM_MODEL=gemini-2.0-flash

# ขนาด chunk (เอกสารกฎหมายไทยยาว — ค่าใหญ่ขึ้นช่วยรักษาบริบทมาตรา)
# CHUNK_SIZE=1800
# CHUNK_OVERLAP=200
