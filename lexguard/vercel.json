{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/law-analyze.js": {
      "maxDuration": 300
    },
    "api/law-relate.js": {
      "maxDuration": 300
    },
    "api/law-repeal-check.js": {
      "maxDuration": 300
    }
  },
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/"
    }
  ]
}
