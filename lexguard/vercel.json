{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/law-analyze.js": {
      "maxDuration": 300
    },
    "api/law-relate.js": {
      "maxDuration": 300
    },
    "api/law-repeal-check.js": {
      "maxDuration": 300
    },
    "api/law-screen.js": {
      "maxDuration": 300
    },
    "api/req-preassess.js": {
      "maxDuration": 300
    },
    "api/law-action-guide.js": {
      "maxDuration": 300
    },
    "api/queue-run.js": {
      "maxDuration": 300
    },
    "api/law-overview.js": {
      "maxDuration": 300
    },
    "api/req-breakdown.js": {
      "maxDuration": 300
    }
  },
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/"
    }
  ]
}
