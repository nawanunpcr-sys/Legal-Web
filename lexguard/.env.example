VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxx
# โหมด auth: 'demo' = ล็อกอินด้วยบัญชีจำลอง (ช่วงทดลองใช้ภายใน) · เปลี่ยนเป็น 'supabase' เมื่อขึ้นใช้จริง
VITE_AUTH_MODE=demo
# Server-side only (Vercel env var) — required for the AI Skill features (analyze / update):
ANTHROPIC_API_KEY=sk-ant-xxxx
# optional: override default model
# ANTHROPIC_MODEL=claude-sonnet-4-6
