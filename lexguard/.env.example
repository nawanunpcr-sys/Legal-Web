VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxx
# โหมด auth: 'demo' = ล็อกอินด้วยบัญชีจำลอง (ช่วงทดลองใช้ภายใน) · เปลี่ยนเป็น 'supabase' เมื่อขึ้นใช้จริง
VITE_AUTH_MODE=demo
# รหัสผ่านสำหรับบัญชี demo ทุกบัญชี (jorpor/viewer) — ถ้าไม่ตั้งค่า จะล็อกอินโหมด demo ไม่ได้เลย
# เปลี่ยนค่านี้เป็นรหัสของคุณเองก่อนใช้งาน ห้ามใช้ค่า changeme จริง
VITE_DEMO_PASSWORD=changeme
# Server-side only (Vercel env var) — required for the AI Skill features (analyze / update):
ANTHROPIC_API_KEY=sk-ant-xxxx
# optional: override default model
# ANTHROPIC_MODEL=claude-sonnet-4-6
